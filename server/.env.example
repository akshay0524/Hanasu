# MongoDB Database
# Local:      mongodb://127.0.0.1:27017/hanasu
# Production: mongodb+srv://<username>:<password>@cluster0.mongodb.net/hanasu?retryWrites=true&w=majority
MONGO_URI="mongodb+srv://<db_username>:<password>@hanasu.ky32ceo.mongodb.net/hanasu?retryWrites=true&w=majority&appName=hanasu"

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id_here

# JWT Secret — generate a long random string
JWT_SECRET=your_jwt_secret_here

# Google Gemini AI (Free API Key)
GEMINI_API_KEY=

# OpenAI (optional — leave blank to disable AI features)
OPENAI_API_KEY=

# Server
PORT=5000
NODE_ENV=development

# Frontend origin — used for CORS (must match your frontend URL)
# Local:      http://localhost:5173
# Production: https://akshay0524.github.io
CLIENT_URL=http://localhost:5173
